#!/usr/bin/env perl
# The recording genesis the harness copies onto the fixture path, where it
# stands in front of the real one under the name every child resolves.  It
# writes one JSON line per child, with what the child was handed and what the
# switch lock was doing around it, and then either runs the real genesis or
# answers with the forced exit the row asked for.
#
# It is a script rather than a sub in the test's own process, for the same
# reason the GitHub double is a fixture curl, which is that the thing being
# watched is a child process and a double living in the parent's memory would
# never see one.  The plan the harness wrote is named by the environment, so
# it reaches a child spawned in the middle of a whole command.
use strict;
use warnings;

use Cwd ();
use Fcntl qw/:flock/;
use IO::Handle ();
use JSON::PP;
use POSIX ();

# The status the recorder answers with where the fixture itself cannot go on,
# or where a child's own status was lost.  It is a value of the file's own
# rather than whatever errno happened to hold, because the recorder stands in
# for a genesis child and a row reads its exit as that child's exit, so a
# refusal must not borrow 2 and read as a usage error, or 86 and read as the
# prerequisites check, or one of the codes Genesis::Exit names.  99 is none of
# those, is no exit the design names, and is not the 127 a failed exec here
# answers with.
use constant REFUSED => 99;

my $plan = read_json($ENV{GENESIS_HARNESS_CHILD_PLAN}) || {};

# The stranger takes the lock before anything is read, so the window D46
# leaves open is already occupied when the child's own start is recorded.
my $holder = $plan->{hold_lock} ? hold_the_lock($plan) : undef;

my %record = (
	argv          => [@ARGV],
	pid           => $$,
	started       => time,
	cwd           => Cwd::getcwd(),
	stdin_is_tty  => (-t STDIN ? 1 : 0),
	lock_at_start => probe($plan->{lock}),
	lock_seen     => [],
	status_lost   => JSON::PP::false,
);

my $exit = 0;
if (defined $plan->{exit}) {
	$exit = $plan->{exit};
	push @{$record{lock_seen}}, probe($plan->{lock}) if $plan->{probe};

} elsif ($plan->{exec} && $plan->{real}) {
	# A run that is polled has to be waited on rather than handed the whole
	# process, because what the lock was doing while the child ran can only be
	# read by something still running beside it.
	if ($plan->{probe}) {
		my $pid = fork();
		die "the recorder could not fork the real genesis: $!\n"
			unless defined $pid;
		unless ($pid) {
			exec {$plan->{real}} $plan->{real}, @ARGV;
			POSIX::_exit(127);
		}
		# The loop ends on any answer other than 0, because 0 is the one
		# answer that means the child is still running.  A child somebody
		# else has already reaped answers -1, and a loop that waits for
		# the pid it forked would spin on that until the suite's own
		# timeout took it.
		my $reaped = 0;
		while (!($reaped = waitpid($pid, POSIX::WNOHANG()))) {
			push @{$record{lock_seen}}, probe($plan->{lock});
			select undef, undef, undef, 0.05;
		}
		if ($reaped == $pid) {
			$exit = $? >> 8;
		} else {
			# Somebody else reaped the child, so what it answered with is
			# gone and nothing here can say what it was.  The record says
			# so in a field of its own and the run answers REFUSED, because
			# a child whose status nobody saw must not read back as a child
			# that succeeded.
			$record{status_lost} = JSON::PP::true;
			$exit = REFUSED;
		}

	} else {
		system {$plan->{real}} $plan->{real}, @ARGV;
		$exit = $? >> 8;
	}
}

$record{ended}       = time;
$record{exit}        = $exit;
$record{lock_at_end} = probe($plan->{lock});

release_the_lock($holder) if $holder;

if ($plan->{log} && open(my $fh, '>>', $plan->{log})) {
	print $fh JSON::PP->new->canonical->encode(\%record), "\n";
	close $fh;
}
exit $exit;

# read_json - one file's contents as a hashref, or undef {{{
sub read_json {
	my ($file) = @_;
	return undef unless defined $file && -f $file;
	open my $fh, '<', $file or return undef;
	my $body = do {local $/; <$fh>};
	close $fh;
	return eval {JSON::PP->new->decode($body)};
}

# }}}
# refuse - say why the fixture cannot go on, and answer with one status {{{
#
# A print and an exit rather than a die, because a die leaves the status to
# errno and a row reads whatever the recorder exits with as the exit of the
# command it was watching.
#
# A refusal takes the lock holder down with it where one is still running,
# because the holder is a process of its own and an orphan that goes on to
# take the switch lock is a stranger the next row never asked for.
sub refuse {
	my ($message, $holder) = @_;
	release_the_lock($holder) if defined $holder;
	print STDERR $message;
	exit REFUSED;
}

# }}}
# probe - is the switch lock held, and by whom {{{
#
# A non-blocking flock, so the recorder answers rather than waiting.  The
# holder writes its pid on the first line and its command on the second, which
# is how a recorded child can name the stranger standing in the window.
sub probe {
	my ($file) = @_;
	return undef unless defined $file && -f $file;

	open my $fh, '<', $file or return undef;
	if (flock($fh, LOCK_EX | LOCK_NB)) {
		flock($fh, LOCK_UN);
		close $fh;
		return undef;
	}
	my $held = do {local $/; <$fh>};
	close $fh;

	my ($pid, $command) = split /\n/, (defined $held ? $held : ''), 2;
	chomp $command if defined $command;
	return {pid => $pid, command => $command};
}

# }}}
# hold_the_lock - take the switch lock in a process of its own {{{
#
# The holder is a separate process because a lock this process took would be
# a lock the child inherits rather than one it meets, and the window D46
# leaves open is a window somebody else is standing in.
sub hold_the_lock {
	my ($plan) = @_;

	my $pid = fork();
	die "the recorder could not fork a lock holder: $!\n" unless defined $pid;
	unless ($pid) {
		# The recorder's pid is read before the lock is asked for, because
		# flock waits as long as it has to and a holder that read the pid
		# afterwards would read 1 wherever the recorder had gone in the
		# meantime, then compare 1 against 1 for the rest of its turns and
		# hold a lock nobody is waiting on it to release.
		my $parent = getppid();
		open my $fh, '>', $plan->{lock} or POSIX::_exit(2);
		flock($fh, LOCK_EX) or POSIX::_exit(2);

		# The recorder may have refused and gone while we waited, and a
		# lock taken for a run that is over is a lock held for nothing, so
		# we let go of it at once rather than announcing ourselves.
		POSIX::_exit(0) unless _parent_is_alive($parent);
		print $fh sprintf("%d\n%s\n", $$, $plan->{hold_lock});
		$fh->flush;

		# Held until the recorder releases us, and never outliving the
		# recorder, so a child that dies leaves no process behind.
		for (1 .. 3000) {
			POSIX::_exit(0) unless _parent_is_alive($parent);
			select undef, undef, undef, 0.1;
		}
		POSIX::_exit(0);
	}

	# Wait for the holder to have the lock, so the child never races it.
	# The holder writes its pid as soon as it has the lock, so a file with
	# something in it is a lock that is held.  Every turn asks whether the
	# holder is still running as well, because a holder that could not open
	# the lock file exits and no amount of waiting will grow the file, and
	# a wait that ran out is a lock nobody took either.  Both say so here
	# rather than letting a row assert a refusal against a lock that was
	# never held.
	my $taken = 0;
	for (1 .. 100) {
		if (-s $plan->{lock}) {
			$taken = 1;
			last;
		}
		# This refusal hands no holder on, because the wait above has just
		# answered that there is no holder left to take down.
		refuse("the recorder's lock holder exited before it took the lock\n")
			if waitpid($pid, POSIX::WNOHANG()) != 0;
		select undef, undef, undef, 0.05;
	}
	refuse("the recorder's lock holder did not take the lock in five seconds\n",
		$pid) unless $taken;
	return $pid;
}

# }}}
# _parent_is_alive - is the recorder that forked us still there {{{
#
# Two questions rather than one, because a recorder that has gone leaves us
# reparented, which the first catches, and a recorder that is still ours but
# no longer running is what the second catches.
sub _parent_is_alive {
	my ($parent) = @_;
	return 0 unless getppid() == $parent;
	return kill(0, $parent) ? 1 : 0;
}

# }}}
# release_the_lock - let the holder go and reap it {{{
sub release_the_lock {
	my ($pid) = @_;
	kill 'TERM', $pid;
	waitpid($pid, 0);
	return;
}

# }}}
