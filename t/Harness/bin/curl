#!/usr/bin/env perl
# The GitHub double.  Genesis::curl shells out, so a fixture curl first on the
# path reaches a spawned genesis child, which an in-process double could not.
# Every call is appended to the log and every answer comes from the state file.
use strict;
use warnings;
use JSON::PP;

my %REASON = (
	200 => 'OK',
	201 => 'Created',
	403 => 'Forbidden',
	404 => 'Not Found',
);

my $state_file = $ENV{GENESIS_HARNESS_GH_STATE} or exit 2;
my $log_file   = $ENV{GENESIS_HARNESS_GH_LOG};

my $json  = JSON::PP->new->canonical;
my $state = $json->decode(do {
	open my $fh, '<', $state_file or exit 2;
	local $/; <$fh>;
});

# HEAD is a flag letter inside the first bundle rather than a method, because
# that is how Genesis::curl spells it, and it wants its headers on stdout.
my ($method, $url, $body, $head) = ('GET', undef, undef, 0);
my @argv = @ARGV;
while (@argv) {
	my $arg = shift @argv;
	if    ($arg eq '-X')            {$method = shift @argv}
	elsif ($arg eq '-d')            {$body   = shift @argv}
	elsif ($arg =~ m{^https?://})   {$url    = $arg}
	elsif ($arg eq '-H' || $arg eq '-u' || $arg eq '-D' || $arg eq '-o') {shift @argv}
	elsif ($arg =~ m{^-[a-zA-Z]*I})  {$head  = 1}
}

# The token is read off the environment rather than off the Authorization
# header, because a row asking whether a run carried one is asking about the
# environment the run was given.
if ($log_file) {
	open my $fh, '>>', $log_file or exit 2;
	print $fh $json->encode({
		method => $method, url => $url, body => $body,
		token  => $ENV{GITHUB_AUTH_TOKEN},
	}), "\n";
	close $fh;
}

if ($state->{unreachable}) {
	printf STDERR "curl: (6) Could not resolve host: api.%s\n",
		$state->{domain} // 'github.test';
	exit 6;
}

my $answer = [];
my $status = 200;

if (!defined $url) {
	$status = 404;
	$answer = {message => 'No url was given to the fixture curl'};
} elsif ($url =~ m{/repos/[^/]+/[^/]+/pulls\b}) {
	my $want = $url =~ /state=(\w+)/ ? $1 : 'open';
	$answer = [grep {$want eq 'all' || $_->{state} eq $want} @{$state->{prs} || []}];
	if ($method ne 'GET' && $method ne 'HEAD') {
		$status = 201;
		$answer = {number => scalar(@{$state->{prs} || []}) + 1};
	}
} elsif ($url =~ m{/repos/[^/]+/[^/]+/pulls/(\d+)/reviews$}) {
	my ($pr) = grep {$_->{number} == $1} @{$state->{prs} || []};
	$answer = $pr ? ($pr->{reviews} || []) : [];
} elsif ($url =~ m{/repos/[^/]+/[^/]+/branches/(.+)/protection$}) {
	unless ($state->{admin}) {
		$status = 403;
		$answer = {message => 'Resource not accessible by personal access token'};
	} else {
		$answer = $state->{protection}{$1} || {};
	}
} elsif ($url =~ m{/user$}) {
	$answer = {login => $state->{user} // 'harness'};
}

my $line = sprintf("HTTP/1.1 %d %s\r\n\r\n", $status, $REASON{$status} // 'OK');
if ($head) {
	print $line;
} else {
	print STDERR $line;
	print $json->encode($answer);
}
exit 0;
