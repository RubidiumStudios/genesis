#!/usr/bin/env perl
# The GitHub double.  Genesis::curl shells out, so a fixture curl first on the
# path reaches a spawned genesis child, which an in-process double could not.
# Every call is appended to the log and every answer comes from the state file.
use strict;
use warnings;
use Fcntl qw/:flock/;
use JSON::PP;

my %REASON = (
	200 => 'OK',
	201 => 'Created',
	403 => 'Forbidden',
	404 => 'Not Found',
);

my $state_file = $ENV{GENESIS_HARNESS_GH_STATE} or exit 2;
my $log_file   = $ENV{GENESIS_HARNESS_GH_LOG};

my $json = JSON::PP->new->canonical;

# The state file is read, changed, and written under one exclusive lock held
# from here until the answer is settled, because a create rewrites the file
# whole and the parent's own helpers read and change it too, so two unlocked
# read-modify-writes lose one another's change.  The parent takes the same
# lock when it reaches in.
open my $state_fh, '+<', $state_file or exit 2;
flock($state_fh, LOCK_EX) or exit 2;
my $state = $json->decode(do {local $/; <$state_fh>});

# HEAD is a flag letter inside the first bundle rather than a method, because
# that is how Genesis::curl spells it, and it wants its headers on stdout.
my ($method, $url, $body, $head, $outfile) = ('GET', undef, undef, 0, undef);
my @argv = @ARGV;
while (@argv) {
	my $arg = shift @argv;
	if    ($arg eq '-X')            {$method  = shift @argv}
	elsif ($arg eq '-d')            {$body    = shift @argv}
	elsif ($arg eq '-o')            {$outfile = shift @argv}
	elsif ($arg =~ m{^https?://})   {$url     = $arg}
	elsif ($arg eq '-H' || $arg eq '-u' || $arg eq '-D') {shift @argv}
	elsif ($arg =~ m{^-[a-zA-Z]*I})  {$head   = 1}
}

# The token is read off the environment rather than off the Authorization
# header, because a row asking whether a run carried one is asking about the
# environment the run was given.
if ($log_file) {
	# The lock is held for the append, because two calls running at once
	# would otherwise interleave a line and leave a reader decoding half of
	# each.
	open my $fh, '>>', $log_file or exit 2;
	flock($fh, LOCK_EX) or exit 2;
	seek($fh, 0, 2);
	print $fh $json->encode({
		method => $method, url => $url, body => $body,
		token  => $ENV{GITHUB_AUTH_TOKEN},
	}), "\n";
	close $fh;
}

if ($state->{unreachable}) {
	printf STDERR "curl: (6) Could not resolve host: api.%s\n",
		$state->{domain} // 'github.test';
	exit 6;
}

my $answer = [];
my $status = 200;

if (!defined $url) {
	$status = 404;
	$answer = {message => 'No url was given to the fixture curl'};
} elsif ($url =~ m{/repos/[^/]+/[^/]+/pulls/(\d+)/reviews$}) {
	my ($pr) = grep {$_->{number} == $1} @{$state->{prs} || []};
	$answer = $pr ? ($pr->{reviews} || []) : [];
} elsif ($url =~ m{/repos/[^/]+/[^/]+/pulls(?:\?|$)}) {
	# The collection is anchored, so a request for one pull request's reviews
	# reaches the branch above rather than reading as a listing.
	if ($method eq 'GET' || $method eq 'HEAD') {
		my $want = $url =~ /state=(\w+)/ ? $1 : 'open';
		$answer = [grep {$want eq 'all' || $_->{state} eq $want} @{$state->{prs} || []}];
	} else {
		# A create lands in the state, so the listing after it sees what was
		# made rather than an empty set.
		my $sent = {};
		eval {$sent = $json->decode($body // '{}'); 1} or $sent = {};
		my $number = scalar(@{$state->{prs} || []}) + 1;
		push @{$state->{prs}}, {
			number  => $number,
			state   => 'open',
			merged  => JSON::PP::false,
			head    => {ref => $sent->{head} // ''},
			base    => {ref => $sent->{base} // ''},
			title   => $sent->{title} // '',
			body    => $sent->{body}  // '',
			created_at => '2026-09-13T00:00:00Z',
			reviews => [],
		};
		seek($state_fh, 0, 0);
		truncate($state_fh, 0);
		print $state_fh $json->encode($state);
		close $state_fh;
		$status = 201;
		$answer = {number => $number};
	}
} elsif ($url =~ m{/repos/[^/]+/[^/]+/branches/(.+)/protection$}) {
	unless ($state->{admin}) {
		$status = 403;
		$answer = {message => 'Resource not accessible by personal access token'};
	} else {
		$answer = $state->{protection}{$1} || {};
	}
} elsif ($url =~ m{/user$}) {
	$answer = {login => $state->{user} // 'harness'};
}

my $line = sprintf("HTTP/1.1 %d %s\r\n\r\n", $status, $REASON{$status} // 'OK');
if ($head) {
	print $line;
} else {
	print STDERR $line;
	# A caller that asked for -o gets the body in the file it named and
	# nothing on stdout, which is what the real curl does and what
	# Genesis::curl expects when it is handed a file to write.
	my $payload = $json->encode($answer);
	if (defined $outfile) {
		open my $fh, '>', $outfile or exit 2;
		print $fh $payload;
		close $fh;
	} else {
		print $payload;
	}
}
exit 0;
