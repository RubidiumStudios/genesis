#!/bin/bash
# test-changed - run the tests a change reaches, one tier at a time
#
# Usage: t/bin/test-changed [BASE] [JOBS]
#
# Asks t/bin/affected-tests for each tier's tests that the change since BASE
# (HEAD by default: what is uncommitted) reaches, and runs them as make test
# would: the unit tier side by side on JOBS processes, the others one at a
# time, every tier reading stdin from /dev/null.  Stops at the first tier
# that fails, and says so when no test is reached at all.
set -u
cd "$(dirname "$0")/../.." || exit 2

base="${1:-HEAD}"
jobs="${2:-4}"
ran=0

for tier in sanity-tests unit-tests integration-tests e2e-tests; do
	tests=$(t/bin/affected-tests --base "$base" --tier "$tier") || exit 2
	[[ -n "$tests" ]] || continue
	ran=1
	echo "== $tier: $(wc -w <<<"$tests" | tr -d ' ') test file(s) reached"
	if [[ "$tier" == unit-tests ]]; then
		prove -l --state=slow,save -j"$jobs" $tests < /dev/null || exit 1
	else
		prove -l --state=save $tests < /dev/null || exit 1
	fi
done

[[ $ran -eq 1 ]] || echo "No test reaches the change since $base."
