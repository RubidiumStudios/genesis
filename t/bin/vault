#!/bin/bash
set -ue

vault_pid=""
bail() {
	printf >&2 $*
	[[ -n "$vault_pid" ]] && kill $vault_pid 2>/dev/null
	exit 2
}

[[ -n "$GENESIS_TOPDIR" ]] || bail "No GENESIS_TOPDIR defined -- cannot start vault"

# The calling test's own work area, t/tmp/<pid>, which helper exports; a run
# by hand falls back to t/tmp.
work="${GENESIS_TEST_TMP:-${GENESIS_TOPDIR}/t/tmp}"
export HOME="${work}/home"
export VAULTS_DIR="${GENESIS_TOPDIR}/t/vaults"
[[ -d $HOME ]] || mkdir -p "$HOME"
[[ -d $VAULTS_DIR ]] || mkdir -p "$VAULTS_DIR"
touch "$HOME/.vault_token"  # Hack around safe init issue
cd "${GENESIS_TOPDIR}" >/dev/null 2>&1

version="${GENESIS_TEST_VAULT_VERSION:-1.0.2}"
platform=
target="${1:-genesis-ci-unit-tests}"
arch=amd64
case $OSTYPE in
(darwin*) platform=darwin ;;
(linux*)  platform=linux  ;;
(*)
	bail "UNRECOGNIZED OSTYPE '$OSTYPE'"
	;;
esac

cmd="${VAULTS_DIR}/vault-${version}-${platform}"

if [[ ! -f "$cmd" ]]; then
	printf >&2 "\rDownloading Vault ${version} CLI for $platform ..."
	# Unpacked in this process's own area and moved into place in one step,
	# so two files downloading at once never read a half-written binary.
	curl --fail -sLk > "$work/archive.zip" \
		https://releases.hashicorp.com/vault/${version}/vault_${version}_${platform}_${arch}.zip \
		|| bail "\nFAILED - could not download of vault ${version}"

	unzip -d "$work" "$work/archive.zip" > /dev/null 2>&1
	mv "$work/vault" "$cmd"
	printf >&2 "DONE\n\n"
fi

# A port the kernel says is free, and a check that the vault answers on it,
# both in perl rather than lsof, which a stock Linux image may not carry.  A
# file starting beside this one can take the port between the check and the
# bind, so a vault that dies before it answers is started again on another.
free_port() {
	perl -MIO::Socket::INET -e 'print IO::Socket::INET->new(Listen => 1, LocalAddr => "127.0.0.1", LocalPort => 0)->sockport'
}
answers() {
	perl -MIO::Socket::INET -e 'exit(IO::Socket::INET->new(PeerAddr => "127.0.0.1:$ARGV[0]", Timeout => 1) ? 0 : 1)' "$1"
}

for attempt in 1 2 3; do
	port=$(free_port)
	$cmd server -config <(cat <<EOF
disable_mlock = 1
listener "tcp" {
  address     = "127.0.0.1:$port"
  tls_disable = 1
}
storage "inmem" {}
EOF
) >$HOME/log 2>&1 &
	vault_pid=$!
	[ -n "${DEBUG_TESTS:-}" ] && printf >&2 "\rStarting Vault ${version} CLI on port $port as '$target' (pid: $vault_pid)..."
	waitfor=600
	while kill -0 $vault_pid 2>/dev/null && ! answers $port; do
		if [[ $waitfor -gt 0 ]]; then
			waitfor=$((waitfor - 1))
			sleep 0.1
		else
			bail "\nFAILED - timed out waiting for vault server to start\n"
		fi
	done
	kill -0 $vault_pid 2>/dev/null && break
	vault_pid=""
done
[[ -n "$vault_pid" ]] || bail "\nFAILED - vault server would not start on a free port\n"
safe target "$target" http://127.0.0.1:$port --no-strongbox >/dev/null 2>&1
safe auth token <<<"dummy" > /dev/null 2>&1 # Another Hack around safe init issue
root_token=$(safe init --json | jq -r '.root_token')
safe auth token <<<${root_token} >/dev/null 2>&1
if ! safe exists "secret/handshake" ;  then
  bail "\nFAILED - failed to unseal vault\n"
fi

[ -n "${DEBUG_TESTS:-}" ] && printf >&2 "done.\n"
echo $vault_pid
exit 0
