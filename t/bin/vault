#!/bin/bash
# vault - start a secrets engine for a test file, through safe local
#
# Usage: t/bin/vault [target]
#
# Starts an in-memory engine with `safe local`, targets it as <target> in the
# calling test's HOME, and prints the pid that stops it.  safe local
# initialises, unseals and authenticates the engine itself.
#
# GENESIS_TEST_SECRETS_ENGINE names the engine, as <engine> or
# <engine>@<version>, and is vault@1.14.4 unless set.  A version runs the copy
# installed under t/engines, which this never downloads: a missing one stops
# here, naming `make install-secrets-engine`.  A bare name runs whichever copy
# is on PATH.
set -ue

pid=""
bail() {
	printf >&2 '%s\n' "$*"
	[[ -n "$pid" ]] && kill "$pid" 2>/dev/null
	exit 2
}

[[ -n "${GENESIS_TOPDIR:-}" ]] || bail "No GENESIS_TOPDIR defined -- cannot start vault"

# The calling test's own work area, t/tmp/<pid>, which helper exports; a run
# by hand falls back to t/tmp.
work="${GENESIS_TEST_TMP:-${GENESIS_TOPDIR}/t/tmp}"
export HOME="${work}/home"
mkdir -p "$HOME"
target="${1:-genesis-ci-unit-tests}"
log="$HOME/log-$target"

spec="${GENESIS_TEST_SECRETS_ENGINE:-vault@1.14.4}"
engine="${spec%%@*}"
version=""
[[ "$spec" == *@* ]] && version="${spec#*@}"
case "$engine" in
	(vault|bao) ;;
	(*) bail "Unknown secrets engine '$engine' in GENESIS_TEST_SECRETS_ENGINE: expected vault or bao" ;;
esac

if [[ -n "$version" ]]; then
	dir="$GENESIS_TOPDIR/t/engines/$engine/$version"
	[[ -x "$dir/$engine" ]] ||
		bail "$engine $version is not installed; run: make install-secrets-engine ENGINE=$engine VERSION=$version"
	export PATH="$dir:$PATH"
fi
command -v "$engine" >/dev/null 2>&1 ||
	bail "No $engine on PATH; install one, or run: make install-secrets-engine ENGINE=$engine VERSION=<version>"

# safe local takes the first vault on PATH, which the line above arranged.
# Only an older safe lacks --engine, and it can run vault that way but never
# OpenBao.
engine_flag=()
if safe local --help 2>&1 | grep -q -- '--engine'; then
	engine_flag=(--engine "$engine")
elif [[ "$engine" != vault ]]; then
	bail "$engine needs a safe whose 'local' takes --engine, and this safe's does not"
fi

# A port the kernel says is free.  A file starting beside this one can take
# it between the check and the bind, so an engine that exits before it
# answers is started again on another.
free_port() {
	perl -MIO::Socket::INET -e 'print IO::Socket::INET->new(Listen => 1, LocalAddr => "127.0.0.1", LocalPort => 0)->sockport'
}

for attempt in 1 2 3; do
	port=$(free_port)
	safe local --memory --as "$target" --port "$port" ${engine_flag[@]+"${engine_flag[@]}"} \
		> "$log" 2>&1 < /dev/null &
	pid=$!
	waitfor=400
	while kill -0 "$pid" 2>/dev/null &&
	      ! SAFE_TARGET="$target" safe exists secret/handshake >/dev/null 2>&1; do
		[[ $((waitfor--)) -gt 0 ]] || bail "Timed out waiting for $engine to start; see $log"
		sleep 0.05
	done
	kill -0 "$pid" 2>/dev/null && break
	pid=""
done
[[ -n "$pid" ]] || bail "$engine would not start on a free port; see $log"

# safe local leaves strongbox unset in .saferc, and the suite has always run
# with it off, so the target is written again with it off and the token safe
# local issued is handed back to it.
token=$(SAFE_TARGET="$target" safe env --json | jq -r .VAULT_TOKEN)
safe target "$target" "http://127.0.0.1:$port" --no-strongbox >/dev/null 2>&1
SAFE_TARGET="$target" safe auth token <<<"$token" >/dev/null 2>&1
SAFE_TARGET="$target" safe exists secret/handshake >/dev/null 2>&1 ||
	bail "$engine started, but the target could not read it after strongbox was turned off; see $log"

echo "$pid"
