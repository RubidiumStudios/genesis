#!/usr/bin/env perl
# test-progress - how far a test run has got, read from its log
#
# Usage: t/bin/test-progress [-w SECONDS] [-j JOBS] [LOG]
#                            [--manifest FILE] [--state FILE]
#
# Reads the output of `make test` (t/tmp/last-run.log unless LOG is given)
# and prints each tier's files done out of its total, the failures so far,
# the time elapsed, and an estimate of the time left from each remaining
# file's duration in the last run that prove saved to .prove.  The unit
# tier's estimate is divided by JOBS (one per processor by default), since
# it runs side by side.  With -w it refreshes every SECONDS until the run
# ends: every file is done, or a tier has failed, which ends make test.
#
# It only reads the log and .prove, so watching a run costs the run nothing.
use strict;
use warnings;

use Cwd qw/abs_path/;
use File::Basename qw/dirname/;
use Getopt::Long;
use POSIX qw/strftime/;

my $root = dirname(dirname(dirname(abs_path(__FILE__))));
my ($watch, $jobs);
my $manifest = "$root/t/test-manifest.txt";
my $state    = "$root/.prove";
GetOptions('w=i' => \$watch, 'j=i' => \$jobs,
           'manifest=s' => \$manifest, 'state=s' => \$state)
	or die "Usage: $0 [-w SECONDS] [-j JOBS] [LOG]\n";
my $log = shift // "$root/t/tmp/last-run.log";
$jobs ||= (qx(getconf _NPROCESSORS_ONLN 2>/dev/null) =~ /(\d+)/)[0] || 4;

my @TIERS = qw/sanity-tests unit-tests integration-tests e2e-tests/;
my %files = map {
	my $tier = $_;
	($tier => [split ' ', qx($root/t/bin/parse-manifest $manifest $tier 2>/dev/null)]);
} @TIERS;

# The last run's duration of each file, from prove's saved state.
my %took;
if (open my $fh, '<', $state) {
	my $test;
	while (<$fh>) {
		$test = $1 if /^  (t\/\S+\.t):\s*$/;
		$took{$test} = $1 if $test && /^\s+elapsed:\s*([\d.]+)/;
	}
}

sub report {
	open my $fh, '<', $log or die "Cannot read $log: $!\n";
	my (%done, %failed, $first, $last, $ended, $last_file);
	my $pending;
	my %tier_of = map {my $t = $_; map {($_ => $t)} @{$files{$t}}} @TIERS;
	while (<$fh>) {
		if (/^\[(\d\d:\d\d:\d\d)\] (t\/\S+\.t) \.+\s*(.*)$/) {
			$first //= $1;
			$last = $1;
			my ($file, $said) = ($2, $3);
			$last_file = $file;
			if ($said =~ /^(ok|skipped)/) {
				$done{$file} = 1;
			} else {
				$pending = $file;
			}
		} elsif ($pending && /^(Dubious|Failed|Parse errors|No subtests run)/) {
			$done{$pending} = $failed{$pending} = 1;
			undef $pending;
		}
		# make test stops at the first tier that fails, and ends with the
		# summary of the prove that ran the last tier.
		$ended = 1 if /^Result: FAIL/;
		$ended = 1 if /^Result: / && ($tier_of{$last_file // ''} // '') eq $TIERS[-1];
	}
	close $fh;
	$ended = 1 unless grep {!$done{$_}} map {@{$files{$_}}} @TIERS;

	my $now = strftime('%H:%M:%S', localtime);
	my @lines = sprintf("%s  started %s", $now, $first // '-');
	# A tier a later tier has followed is over, whatever its count says: the
	# manifest read here is the tree's as it is now, and a file added to it
	# after the run started is one this run never ran.
	my %started = map {my $t = $_; ($t => scalar grep {$done{$_}} @{$files{$t}})} @TIERS;
	my ($left, $unknown) = (0, 0);
	for my $i (0 .. $#TIERS) {
		my $tier = $TIERS[$i];
		my @all  = @{$files{$tier}};
		my $n    = grep {$done{$_}} @all;
		my @todo = grep {!$done{$_}} @all;
		my $over = grep {$started{$_}} @TIERS[$i + 1 .. $#TIERS];
		my $state = !@todo ? '  done'
		          : $over  ? sprintf('  done, %d not in this run', scalar @todo)
		          : $n     ? '  running' : '';
		@todo = () if $over;
		$unknown += grep {!defined $took{$_}} @todo;
		my $rest = 0;
		$rest += $took{$_} // 0 for @todo;
		$rest /= $jobs if $tier eq 'unit-tests';
		$left += $rest;
		push @lines, sprintf("  %-18s %4d / %-4d%s", $tier, $n, scalar(@all), $state);
	}
	my @fails = sort keys %failed;
	push @lines, @fails
		? ("  failed so far:", map {"    $_"} @fails)
		: "  no failures so far";
	# An estimate from some of the files would read as one for all of them,
	# so none is given until every file left has a time from a past run.
	push @lines, !$unknown
		? sprintf("  about %d min left, from the last run's times", int($left / 60 + 0.5))
		: sprintf("  no estimate: %d file(s) left have no time in .prove from a past run", $unknown);
	return (join("\n", @lines) . "\n", $ended);
}

while (1) {
	my ($text, $ended) = report();
	print $watch ? "\e[H\e[J$text" : $text;
	last if !$watch || $ended;
	sleep $watch;
}
