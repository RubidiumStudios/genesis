#!/bin/bash
# install-secrets-engine - install a secrets engine the test suite can run
#
# Usage: t/bin/install-secrets-engine <vault|bao> <version>
#        make install-secrets-engine ENGINE=<vault|bao> VERSION=<version>
#
# Downloads the release built for this host into t/engines/<engine>/<version>/
# and checks it against the release's published SHA-256 sums before putting
# it in place.  Tests never download: t/bin/vault runs an installed engine
# and names this command when the one asked for is missing.
#
# Vault comes from releases.hashicorp.com, OpenBao from its GitHub releases.
# A version with no build for this host is refused, except that a Mac on
# Apple silicon takes the amd64 build of an old vault, which runs under
# Rosetta, and says so.
set -euo pipefail

bail() { printf >&2 '%s\n' "$*"; exit 2; }

engine="${1:-}"
version="${2:-}"
[[ -n "$engine" && -n "$version" ]] ||
	bail "Usage: $0 <vault|bao> <version>"
version="${version#v}"

root="$(cd "$(dirname "$0")/../.." && pwd)"
dest="$root/t/engines/$engine/$version"

case "$(uname -s)" in
	(Darwin) os=darwin ;;
	(Linux)  os=linux  ;;
	(*) bail "No $engine build is known for $(uname -s)" ;;
esac
case "$(uname -m)" in
	(arm64|aarch64) arch=arm64 ;;
	(x86_64|amd64)  arch=amd64 ;;
	(*) bail "No $engine build is known for $(uname -m)" ;;
esac

if command -v sha256sum >/dev/null 2>&1; then
	sha256() { sha256sum "$1" | cut -d' ' -f1; }
else
	sha256() { shasum -a 256 "$1" | cut -d' ' -f1; }
fi

case "$engine" in
	(vault)
		base="https://releases.hashicorp.com/vault/$version"
		asset() { echo "vault_${version}_${os}_$1.zip"; }
		sums="vault_${version}_SHA256SUMS"
		;;
	(bao)
		base="https://github.com/openbao/openbao/releases/download/v$version"
		asset() { echo "openbao_${version}_${os}_$1.tar.gz"; }
		sums="checksums.txt"
		;;
	(*) bail "Unknown engine '$engine': expected vault or bao" ;;
esac

if [[ -x "$dest/$engine" ]]; then
	echo "$engine $version is already installed in ${dest#$root/}"
	exit 0
fi

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

curl -fsSL -o "$work/sums" "$base/$sums" 2>/dev/null ||
	bail "No $engine release $version at $base"

file="$(asset "$arch")"
if ! grep -q " $file\$" "$work/sums"; then
	if [[ "$os/$arch" == darwin/arm64 && "$engine" == vault ]] &&
	   grep -q " $(asset amd64)\$" "$work/sums"; then
		file="$(asset amd64)"
		echo "vault $version has no build for Apple silicon; installing the amd64 build, which runs under Rosetta"
	else
		bail "$engine $version has no build for $os/$arch"
	fi
fi

echo "Downloading $file ..."
curl -fsSL -o "$work/$file" "$base/$file" || bail "Could not download $base/$file"

want="$(grep " $file\$" "$work/sums" | cut -d' ' -f1)"
got="$(sha256 "$work/$file")"
[[ "$want" == "$got" ]] ||
	bail "Checksum mismatch for $file: expected $want, got $got"

mkdir -p "$work/unpacked"
case "$file" in
	(*.zip)    unzip -q "$work/$file" -d "$work/unpacked" ;;
	(*.tar.gz) tar -xzf "$work/$file" -C "$work/unpacked" ;;
esac
[[ -x "$work/unpacked/$engine" ]] || bail "$file holds no $engine binary"

# Put in place in one step, so a run starting meanwhile never finds half a
# binary.
mkdir -p "$(dirname "$dest")"
mkdir -p "$work/stage"
mv "$work/unpacked/$engine" "$work/stage/$engine"
rm -rf "$dest"
mv "$work/stage" "$dest"
echo "Installed $engine $version in ${dest#$root/}: $("$dest/$engine" version | head -1)"
